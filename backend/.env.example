# Rename this file to .env before running the server

# MongoDB Atlas connection string (see README Step 3)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/safepath_ai?retryWrites=true&w=majority

# Any long random string - used to sign JWT tokens
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Port the backend server runs on
PORT=5000

# The URL your frontend runs on (Vite default)
CLIENT_URL=http://localhost:5173

# development or production
NODE_ENV=development
